lang Nav {buoy[Capesize], buoy[Suezmax], buoy, revoked}.

trust (dma, buoy1) with {Nav: buoy[Capesize]};
trust (dma, buoy2) with {Nav: buoy[Suezmax]};



when (eval(dma, buoy1, {Nav: buoy[Capesize]})) do {
    trust (captain, buoy1) with {Nav: buoy[Capesize]}
} otherwise {
    trust (captain, buoy1) with {Nav: revoked}};

when (eval(dma, buoy2, {Nav: buoy[Capesize]})) do {
    trust (captain, buoy2) with {Nav: buoy[Capesize]}
} otherwise {
    trust (captain, buoy2) with {Nav: revoked}};



trust (dma, buoy1) with {Nav: revoked}.